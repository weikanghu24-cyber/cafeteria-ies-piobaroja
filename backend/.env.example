# ====== DJANGO ======
SECRET_KEY=django-insecure-CAMBIA-ESTO-EN-PRODUCCION-genera-una-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ====== BASE DE DATOS MySQL ======
# En local (XAMPP/WAMP/MySQL standalone):
DATABASE_URL=mysql://root:password@127.0.0.1:3307/cafeteria_ies
# En Railway/Render te dan una URL automaticamente, sustituye la de arriba

# ====== CORS / FRONTEND ======
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ====== STRIPE (modo TEST) ======
# Las consigues en https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_pon_tu_clave_aqui
STRIPE_SECRET_KEY=sk_test_pon_tu_clave_aqui
STRIPE_WEBHOOK_SECRET=whsec_OPCIONAL_PARA_WEBHOOKS

# ====== GOOGLE OAUTH (opcional, dejar vacio si no tienes) ======
# Las consigues en https://console.cloud.google.com/
# APIs y servicios > Credenciales > Crear ID de cliente OAuth 2.0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ====== CONFIGURACION CAFETERIA ======
# Horas minimas de antelacion para hacer un pedido
PEDIDO_ANTELACION_MIN_MINUTOS=15
# Maximo de dias en el futuro para pedir
